PORT=6000
HOST=localhost

# Local Chrome extension bridge. It is never exposed through the public tunnel.
BROWSER_BRIDGE_ENABLED=true
# Defaults to PORT + 1 when unset.
# BROWSER_BRIDGE_PORT=6001
PUBLIC_BASE_URL=http://localhost:6000

# The externally visible MCP URL. For ChatGPT through a tunnel, use the HTTPS URL.
MCP_PUBLIC_URL=http://localhost:6000/mcp

# Built-in OAuth issuer. Keep this on the same origin as PUBLIC_BASE_URL.
AUTH_ISSUER=http://localhost:6000
REQUIRED_SCOPE=mcp:control

# Keep the server bound to loopback and let the HTTPS tunnel reach it locally.
# Setting this to true permits a non-loopback HOST and is not recommended.
ALLOW_NON_LOOPBACK_BIND=false

# Exact callback URIs take precedence over the origin allowlist. For a public
# deployment, copy the redirect URI already registered for your ChatGPT connector.
ALLOWED_REDIRECT_URIS=
REQUIRE_EXACT_REDIRECT_URIS=true

# Fallback origin allowlist used for local bootstrap when exact URI locking is disabled.
# Loopback HTTP redirect URIs remain available for local development and smoke tests.
ALLOWED_REDIRECT_ORIGINS=https://chatgpt.com

# Browser CORS is not needed for server-to-server MCP traffic, but these exact
# ChatGPT origins are allowed for compatibility. No arbitrary origins are reflected.
CORS_ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com

# OAuth client registrations, signing keys, and refresh-token grants are stored here.
# Run `pnpm harden` after creating the file to restrict its permissions.
OAUTH_STORE_PATH=.data/oauth-store.json

# OAUTH_CONSENT_PIN is no longer used. A fresh numeric PIN is generated for
# every authorization request and logged to the server terminal.

# Access tokens are short-lived; ChatGPT refreshes them without asking you to reconnect.
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_ROTATION_GRACE_SECONDS=60

MAX_REFRESH_TOKENS_PER_GRANT=64
MAX_OAUTH_CLIENTS=20

# Maximum size and timeout for files ChatGPT passes through openai/fileParams.
MAX_CHATGPT_FILE_BYTES=104857600
CHATGPT_FILE_DOWNLOAD_TIMEOUT_MS=60000

# Optional override for PowerShell-based management scripts.
# Defaults to powershell.exe on Windows and pwsh on macOS/Linux.
# POWERSHELL_EXECUTABLE=pwsh

# Optional terminal shell override. Defaults to PowerShell on Windows,
# /bin/bash on macOS, and /bin/sh on Linux.
# TERMINAL_EXECUTABLE=/bin/bash
