{
    "name": "win-codex",
    "version": "1.3.13",
    "description": "Hardened local Streamable HTTP MCP server with terminal, file, and process tools protected by OAuth on Windows and macOS.",
    "main": "dist/server.js",
    "bin": {
        "win-codex-agent": "dist/cli.js"
    },
    "type": "module",
    "packageManager": "pnpm@11.8.0",
    "scripts": {
        "dev": "tsx src/server.ts",
        "agent": "node dist/cli.js",
        "agent-api-test": "pnpm build && node scripts/agent-api-test.mjs",
        "voice-test": "pnpm build && node scripts/voice-api-test.mjs && node scripts/voice-dom-test.mjs",
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/server.js",
        "type": "tsc --noEmit",
        "check": "pnpm type",
        "smoke": "node scripts/run-powershell.mjs scripts/smoke-test.ps1",
        "revoke": "node scripts/run-powershell.mjs scripts/revoke-access.ps1",
        "harden": "node scripts/run-powershell.mjs scripts/harden-acl.ps1",
        "security-test": "pnpm build && node scripts/security-test.mjs",
        "browser-test": "pnpm build && node scripts/browser-test.mjs",
        "support-ui-test": "node scripts/support-ui-test.mjs",
        "support-action-test": "pnpm build && node scripts/support-action-test.mjs",
        "scheduled-tasks-test": "pnpm build && node scripts/scheduled-tasks-test.mjs",
        "thread-sync-test": "pnpm build && node scripts/browser-launch-test.mjs && node scripts/thread-sync-test.mjs && node scripts/subagent-limits-test.mjs && node scripts/task-test.mjs && node scripts/support-ui-test.mjs && node scripts/chatgpt-dom-test.mjs && node scripts/ralph-dom-regression-test.mjs && node scripts/browser-presence-test.mjs && node scripts/browser-error-recovery-test.mjs && node scripts/recovery-reservation-test.mjs && node scripts/support-recovery-test.mjs && node scripts/ralph-monitor-regression-test.mjs && node scripts/ralph-lifecycle-test.mjs && node scripts/scheduled-tasks-test.mjs",
        "support:prepare": "pnpm build && node scripts/prepare-support-extension.mjs",
        "thread-sync:prepare": "pnpm support:prepare"
    },
    "keywords": [
        "mcp",
        "windows",
        "macos",
        "powershell",
        "oauth"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@modelcontextprotocol/node": "2.1.1",
        "@modelcontextprotocol/server": "2.3.0",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "jose": "^6.2.3",
        "playwright-core": "^1.62.1",
        "ws": "^8.21.3",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@modelcontextprotocol/client": "2.3.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^26.0.0",
        "@types/ws": "^8.18.1",
        "tsx": "^4.23.0",
        "typescript": "^6.0.3"
    }
}
