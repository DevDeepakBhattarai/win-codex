{
    "name":  "win-codex",
    "version":  "1.3.12",
    "description":  "Hardened local Streamable HTTP MCP server with terminal, file, and process tools protected by OAuth on Windows and macOS.",
    "main":  "dist/server.js",
    "type":  "module",
    "packageManager":  "pnpm@11.8.0",
    "engines":  {
                    "node":  ">=24.0.0 <25"
                },
    "scripts":  {
                    "dev":  "tsx src/server.ts",
                    "build":  "tsc -p tsconfig.build.json",
                    "start":  "node dist/server.js",
                    "type":  "tsc --noEmit",
                    "check":  "pnpm type",
                    "smoke":  "node scripts/run-powershell.mjs scripts/smoke-test.ps1",
                    "revoke":  "node scripts/run-powershell.mjs scripts/revoke-access.ps1",
                    "harden":  "node scripts/run-powershell.mjs scripts/harden-acl.ps1",
                    "security-test":  "pnpm build && node scripts/security-test.mjs",
                    "browser-test":  "pnpm build && node scripts/browser-test.mjs",
                    "thread-sync-test":  "pnpm build && node scripts/thread-sync-test.mjs",
                    "support:prepare":  "pnpm build && node scripts/prepare-support-extension.mjs",
                    "thread-sync:prepare":  "pnpm support:prepare"
                },
    "keywords":  [
                     "mcp",
                     "windows",
                     "macos",
                     "powershell",
                     "oauth"
                 ],
    "author":  "",
    "license":  "MIT",
    "dependencies":  {
                         "@modelcontextprotocol/sdk":  "^1.29.0",
                         "cors":  "^2.8.6",
                         "dotenv":  "^17.4.2",
                         "express":  "^5.2.1",
                         "jose":  "^6.2.3",
                         "playwright-core":  "^1.62.1",
                         "ws":  "^8.21.3",
                         "zod":  "^4.4.3"
                     },
    "devDependencies":  {
                            "@types/cors":  "^2.8.19",
                            "@types/express":  "^5.0.6",
                            "@types/node":  "^24.0.0",
                            "@types/ws":  "^8.18.1",
                            "tsx":  "^4.23.0",
                            "typescript":  "^6.0.3"
                        }
}
